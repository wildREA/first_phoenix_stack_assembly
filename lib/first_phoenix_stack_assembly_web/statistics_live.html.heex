<Layouts.app flash={@flash}>
  <div class="space-y-10">
    <section class="space-y-3">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">
        Tournament statistics
      </p>
      
      <h1 class="text-4xl font-semibold tracking-tight">Peace of mind tournament</h1>
      
      <p class="max-w-xl text-base-content/70">
        Keep rankings and match results close, temporary, and easy to reshape.
      </p>
    </section>
    
    <.form
      for={@form}
      id="statistics-command-form"
      phx-submit="submit_command"
      class="border border-base-300 bg-base-200 p-3 shadow-sm"
    >
      <label for="statistics-command" class="sr-only">Tournament command</label>
      <div class="flex items-center gap-2">
        <input
          name="command"
          id="statistics-command"
          value={@form[:command].value}
          type="text"
          placeholder="rank: Anthony, Navi, 4000, 100"
          autocomplete="off"
          class="min-w-0 flex-1 bg-transparent px-2 py-2 outline-none placeholder:text-base-content/40"
        />
        <button
          type="submit"
          class="btn btn-primary btn-square"
          aria-label="Submit command"
          title="Submit command"
        >
          <.icon name="hero-paper-airplane" class="size-5" />
        </button>
      </div>
    </.form>
    
    <section class="space-y-3" aria-labelledby="ranking-heading">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="ranking-heading" class="text-2xl font-semibold">Ranking</h2>
         <span class="text-sm text-base-content/60">{@players |> length()} players</span>
      </div>
      
      <div class="overflow-x-auto border border-base-300">
        <table id="players-table" class="w-full text-left text-sm">
          <thead class="bg-base-200 text-xs uppercase tracking-wide text-base-content/60">
            <tr>
              <th class="px-4 py-3">Name</th>
              
              <th class="px-4 py-3">Team</th>
              
              <th class="px-4 py-3">Elo</th>
              
              <th class="px-4 py-3">Win rate</th>
              
              <th><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          
          <tbody>
            <tr
              :for={player <- @players}
              id={"player-#{player.id}"}
              class="border-t border-base-300"
            >
              <td class="px-4 py-3 font-medium">{player.name}</td>
              
              <td class="px-4 py-3">{player.team}</td>
              
              <td class="px-4 py-3">{player.elo_count}</td>
              
              <td class="px-4 py-3">{format_percentage(player.win_rate)}%</td>
              
              <td class="px-4 py-3 text-right">
                <button
                  type="button"
                  phx-click="remove_player"
                  phx-value-name={player.name}
                  class="btn btn-ghost btn-xs text-error"
                  aria-label={"Remove #{player.name}"}
                  title={"Remove #{player.name}"}
                >
                  <.icon name="hero-trash" class="size-4" />
                </button>
              </td>
            </tr>
            
            <tr :if={@players == []} id="players-empty" class="border-t border-base-300">
              <td colspan="5" class="px-4 py-8 text-center text-base-content/60">
                No players in the ranking.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
    
    <section class="space-y-3" aria-labelledby="matches-heading">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="matches-heading" class="text-2xl font-semibold">Matches</h2>
         <span class="text-sm text-base-content/60">{@matches |> length()} results</span>
      </div>
      
      <div class="space-y-3" id="matches-list">
        <article
          :for={match <- @matches}
          id={"match-#{match.id}"}
          class="border border-base-300 bg-base-200 p-4"
        >
          <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-base-content/60">
            <time datetime={Date.to_iso8601(match.date)}>{Date.to_iso8601(match.date)}</time>
            <span>Match #{match.id}</span>
          </div>
          
          <div class="mt-3 flex items-center justify-between gap-4 text-lg font-semibold">
            <span>{match.challenger_team}</span>
            <span class="whitespace-nowrap">
              <span class="text-success">{match.challenger_score}</span>
              : <span class="text-error">{match.contender_score}</span>
            </span> <span>{match.contender_team}</span>
          </div>
        </article>
        
        <p
          :if={@matches == []}
          id="matches-empty"
          class="border border-base-300 px-4 py-8 text-center text-base-content/60"
        >
          No matches recorded.
        </p>
      </div>
    </section>
  </div>
</Layouts.app>
